# -----------------------------
# Deployment / environment settings
# -----------------------------
# - host port publishing
# - selected model identity
# - secrets/tokens
# - host storage paths
#
# Do not put these in vllm-config.yaml unless they are truly
# application-internal and not environment-specific.

# vLLM Docker image tag (pin for reproducibility)
# Example: v0.10.2
VLLM_IMAGE_TAG=v0.10.2

# Name of the container instance
# Used for docker ps / logs / debugging
CONTAINER_NAME=vllm_prod

# Host port exposed on the VM (maps to container port 8000)
# Accessible at: http://<VM_IP>:<VLLM_HOST_PORT>
VLLM_HOST_PORT=8000

# Host directory for Hugging Face cache and model storage
# Should point to persistent storage (e.g. /data volume)
# This avoids re-downloading models between restarts
HF_CACHE_DIR=/data/vllm_models

# Hugging Face model ID used by vLLM to load the model
# Example: Qwen/Qwen3-0.6B
VLLM_MODEL=Qwen/Qwen3-0.6B

# Name exposed to API clients (OpenAI-compatible "model" field)
# This acts as your API contract name and can differ from VLLM_MODEL
# Keep stable to avoid breaking clients
SERVED_MODEL_NAME=qwen3-0.6b

# API key required for all requests to vLLM server
# Clients must include:
# Authorization: Bearer <VLLM_API_KEY>
VLLM_API_KEY=your-long-random-secret

# -----------------------------
# Second GPU deployment
# -----------------------------
# Runs on GPU 1 and publishes a separate host port.

QWEN3_CODER_CONTAINER_NAME=vllm_qwen3_coder
QWEN3_CODER_HOST_PORT=8001
QWEN3_CODER_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
QWEN3_CODER_SERVED_MODEL_NAME=qwen3

# Optional override. Leave empty to reuse VLLM_API_KEY.
QWEN3_CODER_API_KEY=

# Optional Hugging Face token
# Required for:
# - private models
# - gated models (e.g. Llama)
# Leave empty for public models
HF_TOKEN=
