# deployments/.env.example
# ----------------------------------------
# Shared deployment / environment settings
# Copy to .env:  cp .env.example .env
# .env is gitignored — never commit real secrets.
# Hardware layout (GPUs, ports) and secrets belong here.
# model definitions live in each deployment directory in git.
# ----------------------------------------

# --- GPU assignment per model (device ids as in nvidia-smi) ---
# Assign hardware resources here, such as selected GPU devices per model.
# For example:
# GEMMA3_GPU=0
# VOXTRAL_GPU=1

# --- Host port per model (must be unique per VM) ---
# Accessible at: http://<VM_IP>:<port>/v1
# GEMMA3_PORT=8000
# VOXTRAL_PORT=8001

# --- vLLM image tag (pin for reproducible deploys) ---
VLLM_IMAGE_TAG=latest

# API key required for all requests to vLLM server
# Clients must include:
# Authorization: Bearer <VLLM_API_KEY>
VLLM_API_KEY=a-long-random-secret

# --- Host directory for the shared Hugging Face cache ---
# Persistent storage so models are not re-downloaded between restarts
# Host directory for Hugging Face cache and model storage
# Should point to persistent storage (e.g. /data volume)
HF_CACHE_DIR=/data/vllm_models

# --- Hugging Face token ---
# Optional Hugging Face token
# Required for:
# - private models
# - gated models (e.g. Llama)
# Can leave empty if only using public models
HF_TOKEN=