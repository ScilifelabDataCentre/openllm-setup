discovery.kubernetes "pods" {
  role = "pod"
  api_server = sys.env("OPENLLM_K8S_APISERVER")
  bearer_token = sys.env("OPENLLM_K8S_TOKEN")
  namespaces {
    names = ["openllm"]
  }
  // Necessary when using control plane node IPs in OPENLLM_K8S_APISERVER
  tls_config {
    insecure_skip_verify = true
  }
  selectors {
    role = "pod"
    label = "app.kubernetes.io/instance in (openllm,embeddings)"
  }
} // discovery.kubernetes "pods"


discovery.relabel "filtered_pods" {
  targets = discovery.kubernetes.pods.targets
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    action = "replace"
    target_label = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
    separator = "/"
    target_label = "job"
  }

  // explicitly set service_name. if not set, loki will automatically try to populate a default.
  // see https://grafana.com/docs/loki/latest/get-started/labels/#default-labels-for-all-users
  rule {
    action = "replace"
    source_labels = [
      "__meta_kubernetes_pod_label_app_kubernetes_io_name",
    ]
    target_label = "service_name"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_instance"]
    regex = "(.+)"
    target_label = "app_kubernetes_io_instance"
  }

} // discovery.relabel "filtered_pods"


loki.source.kubernetes "pod_logs" {
  targets = discovery.relabel.filtered_pods.output

  // Useful if scaling to more than 1 Alloy Pod
  clustering {
    enabled = true
  }

  client {
    api_server = sys.env("OPENLLM_K8S_APISERVER")
    bearer_token = sys.env("OPENLLM_K8S_TOKEN")
    // Necessary when using control plane node IPs in OPENLLM_K8S_APISERVER
    tls_config {
      insecure_skip_verify = true
    }
  }

  forward_to = [loki.process.pod_logs.receiver]
} // loki.source.kubernetes "pod_logs"


loki.process "pod_logs" {

  stage.cri {
    max_partial_lines = 100
  }

  stage.label_drop {
    values = [
      "filename", // Not useful
    ]
  }

  forward_to = [loki.write.default.receiver]
}


loki.write "default" {
  endpoint {
    url = coalesce(
      sys.env("OPENLLM_LOKI_URL"),
      "http://loki-gateway.loki-stack/loki/api/v1/push",
      )
  }
}
