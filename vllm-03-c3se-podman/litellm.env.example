# Copy to ~/litellm.env on the login node, fill in real values, chmod 600.
# Real secrets live in Bitwarden.
# The DB password appears twice (POSTGRES_PASSWORD and inside DATABASE_URL) and must match.
LITELLM_MASTER_KEY=sk-REPLACE_ME
POSTGRES_USER=litellm
POSTGRES_DB=litellm
POSTGRES_PASSWORD=REPLACE_ME
DATABASE_URL=postgresql://litellm:REPLACE_ME@127.0.0.1:5432/litellm
# Optional admin UI at http://localhost:4000/ui
# UI_USERNAME=REPLACE_ME
# UI_PASSWORD=REPLACE_ME
