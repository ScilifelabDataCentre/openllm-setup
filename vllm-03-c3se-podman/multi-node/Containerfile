# /mimer/NOBACKUP/sll_dc/multinode/Containerfile
#
# The stock vllm-openai image has no Ray. Installing it at service start time
# needs network, takes a minute, and can drift between nodes. Bake it in once
# instead, and ship the same image to every node through Mimer.
#
# Build on one compute node, then distribute:
#   cd <checkout>/vllm-03-c3se-podman/multi-node
#   podman build -t localhost/vllm-ray:0.24.0-ray2.57.0 -f Containerfile .
#   mkdir -p /mimer/NOBACKUP/sll_dc/images
#   podman save -o /mimer/NOBACKUP/sll_dc/images/vllm-ray-0.24.0-ray2.57.0.tar \
#       localhost/vllm-ray:0.24.0-ray2.57.0
#   for n in 38 39 40 41 42; do
#     ssh sll-m11-$n 'podman load -i /mimer/NOBACKUP/sll_dc/images/vllm-ray-0.24.0-ray2.57.0.tar'
#   done

FROM docker.io/vllm/vllm-openai:v0.24.0

# Pinned deliberately. 2.57.0 is the version verified to form a healthy
# multi-node cluster with vLLM 0.24.0 and torch 2.11.0+cu130 on these nodes.
RUN python3 -m pip install --no-cache-dir "ray[default]==2.57.0" \
 && python3 -c "import torch, vllm, ray; print(torch.__version__, vllm.__version__, ray.__version__)"

COPY entry.sh /usr/local/bin/entry.sh
RUN chmod 0755 /usr/local/bin/entry.sh

ENTRYPOINT ["/usr/local/bin/entry.sh"]
