[Unit]
# ~/.config/systemd/user/vllm-multinode@.service
#
# Installed on every node that participates in any multi-node deployment. The
# instance name is the deployment name, matching the conf file on Mimer:
#   /mimer/NOBACKUP/sll_dc/multinode/conf/<name>.conf  ->  vllm-multinode@<name>
#
# The SAME unit and the SAME command run on every node. The launcher works out
# whether this node is the head or a worker. There is deliberately no cross-node
# ordering, because systemd cannot express it; the head polls until every node
# has registered its GPUs instead.
#
# Like vllm@.service, this is a manually started service. It is not enabled at
# boot, because a multi-node model holds several whole nodes and that should be a
# deliberate act.
Description=vLLM multi-node deployment %i
Documentation=file:/mimer/NOBACKUP/sll_dc/multinode/c3se-a100-multinode-runbook.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple

# Same stale-state cleanup the switchboard units use. Note this covers only the
# /tmp paths. Do not add a /run/user/<uid>/libpod wipe here; that belongs in
# manual recovery, since it can disrupt a healthy running container.
ExecStartPre=-/usr/bin/rm -rf /tmp/storage-run-%U/containers /tmp/storage-run-%U/libpod/tmp
ExecStartPre=-/usr/bin/podman rm -f vllm-multinode-%i

ExecStart=/mimer/NOBACKUP/sll_dc/multinode/vllm-multinode.sh %i

ExecStop=/usr/bin/podman stop -t 120 vllm-multinode-%i
ExecStopPost=-/usr/bin/podman rm -f vllm-multinode-%i

# No start timeout: the head waits for the cluster, then loads several hundred
# gigabytes of weights off Mimer, and there is no readiness signal to wait on.
# Do not change Type to notify.
TimeoutStartSec=0
TimeoutStopSec=180

# on-failure rather than always: a deliberate `systemctl --user stop` must stay
# stopped. RestartSec is long because a restart while another node is still down
# just returns to the waiting loop, and a tight loop there only fills the journal.
Restart=on-failure
RestartSec=60

KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=default.target
